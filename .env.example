# .env.example — copy to .env and fill in real values
# .env is gitignored and must NOT be committed

# ── News jobs toggle ────────────────────────────────────────
# 0 = 뉴스 수집/요약/신호(Telegram) 잡 전체 중지. 그 외(KRX/DART/YouTube/Stage/모의투자) 잡은 영향 없음. 기본값 1(ON).
NEWS_JOBS_ENABLED=1

# ── PostgreSQL ────────────────────────────────────────────────
# Required: no default password — set a strong unique value
DB_PASSWORD=<replace_with_strong_password>
DB_HOST=localhost
DB_PORT=5432
DB_NAME=news_db
DB_USER=news_user

# Alternatively, use a single DATABASE_URL instead of DB_* vars:
# DATABASE_URL=postgresql://news_user:<password>@localhost:5432/news_db

# ── KRX API ───────────────────────────────────────────────
# KRX OpenAPI key (openapi.krx.co.kr 가입 후 발급) — OHLCV/지수/종목 마스터용
KRX_OPENAPI_KEY=your_krx_openapi_key
# KRX 포털 계정 (data.krx.co.kr) — 투자자 순매수 데이터용 (krx_flow_sync.py)
KRX_ID=your_krx_id
KRX_PW=your_krx_password
# ── Telegram ─────────────────────────────────────────────────
# Required: bot token from @BotFather
TELEGRAM_TOKEN=<bot_token>

# Required: at least one of these must be set (auth bypass prevention)
# Comma-separated list of allowed chat IDs (preferred for multi-user):
ALLOWED_CHAT_IDS=<chat_id_1>,<chat_id_2>
# Or single chat ID:
# TELEGRAM_CHAT_ID=<chat_id>

# ── Korea macro data ─────────────────────────────────────────
# Update manually when BOK changes the base rate
KOREA_BASE_RATE=3.50

# ── Local LLM — Ollama (primary) ─────────────────────────────
# Ollama server URL — default works if Ollama is running locally
OLLAMA_BASE=http://localhost:11434
# Model to use — must be pulled first: ollama pull <model>
OLLAMA_MODEL=qwen3.5:9b

# ── Local LLM — LM Studio (fallback) ─────────────────────────
# LM Studio server URL — default works with LM Studio local server
LM_STUDIO_BASE=http://localhost:1234
# Model identifier as shown in LM Studio's loaded model list
LM_STUDIO_MODEL=eeve-korean-instruct-10.8b-v1.0

# ── Telegram extras ───────────────────────────────────────────
# Optional: channel ID for screener broadcast (separate from DM)
# Set this if you want chart screener results posted to a Telegram channel.
# Leave blank (or omit) to skip channel delivery — DM only.
# TELEGRAM_CHANNEL_ID=@yourchannel

# ── Dashboard 인증 ───────────────────────────────────────────
# 관리자 계정 (스케줄러 트리거 등 쓰기 권한)
# ADMIN_USER=admin
# ADMIN_PASSWORD=<strong_password>
# 일반 사용자 계정 (읽기 전용 — 조회/스트림만 허용)
# DASHBOARD_USER=viewer
# DASHBOARD_PASSWORD=<strong_password>
# 미설정 시 인증 없음 (로컬 개발용)

# ── OpenDART ─────────────────────────────────────────────────
# 전자공시시스템 API 키 (dart.fss.or.kr → 개발자센터 → 인증키 신청)
DART_API_KEY=your_dart_api_key

# ── Performance tuning ───────────────────────────────────────
# Parallel workers for the chart screener AND daily flow classifier job.
# Default 1 is safe for low-resource hosts.
# REQUIRED for the daily 3-stage classifier to complete before 17:00 KST:
# set SCREENER_WORKERS=8 in production. At 1 worker, 300 tickers ≈ 90s.
SCREENER_WORKERS=2

# Minimum signal count for a ticker to appear in /backtest per-ticker report
# Tickers with fewer signals than this are filtered out of the report.
# BACKTEST_MIN_SIGNALS=10
